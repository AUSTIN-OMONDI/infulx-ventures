[Unit]
Description=Influx Ventures shop
After=network.target

[Service]
User=__USER__
WorkingDirectory=__APPDIR__/infulx
Environment=PYTHONUNBUFFERED=1
# Set the admin password and a secret key here (systemctl edit influx):
# Environment=ADMIN_PASSWORD=change-me
# Environment=SECRET_KEY=long-random-string
ExecStart=__APPDIR__/venv/bin/gunicorn -w 3 -b 127.0.0.1:8000 app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
